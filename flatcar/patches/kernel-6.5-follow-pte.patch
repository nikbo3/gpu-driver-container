--- a/kernel/nvidia/os-mlock.c
+++ b/kernel/nvidia/os-mlock.c
@@ -38,8 +38,23 @@
 // follow_pfn was removed in kernel 6.5 and replaced with follow_pte
 static inline int nv_follow_pfn(struct vm_area_struct *vma, unsigned long address, unsigned long *pfn)
 {
-#if defined(NV_FOLLOW_PFN_PRESENT)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 5, 0)
+    // Kernel 6.5+ uses follow_pte instead of follow_pfn
+    spinlock_t *ptl;
+    pte_t *ptep;
+    int ret;
+
+    ret = follow_pte(vma->vm_mm, address, &ptep, &ptl);
+    if (ret)
+        return ret;
+
+    *pfn = pte_pfn(*ptep);
+    pte_unmap_unlock(ptep, ptl);
+
+    return 0;
+#elif defined(NV_FOLLOW_PFN_PRESENT)
     return follow_pfn(vma, address, pfn);
 #else
     return -EINVAL;
 #endif
 }

